# Copy this file to `.env` and fill in your own values.
# Get API_ID / API_HASH from https://my.telegram.org -> API development tools.
# Get BOT_TOKEN from @BotFather (see README).
# Never commit the real .env file.

API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
PHONE=+919XXXXXXXXX

# Control bot (optional but recommended for `python bot.py`).
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Your numeric Telegram user id. Leave blank to use one-time pairing instead.
OWNER_ID=
