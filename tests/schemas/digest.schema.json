{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tg-digest output",
  "type": "object",
  "required": [
    "ai_instructions",
    "meta",
    "channels"
  ],
  "properties": {
    "ai_instructions": {
      "type": "string",
      "minLength": 1
    },
    "meta": {
      "type": "object",
      "required": [
        "generated_at",
        "timezone",
        "from",
        "to",
        "channels_ok",
        "messages_total",
        "part"
      ],
      "properties": {
        "generated_at": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"
        },
        "channels_ok": {
          "type": "integer",
          "minimum": 0
        },
        "messages_total": {
          "type": "integer",
          "minimum": 0
        },
        "part": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$"
        },
        "truncated_channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "channel",
              "reason"
            ],
            "properties": {
              "channel": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "link_base",
          "count"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "channel",
              "group"
            ]
          },
          "link_base": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "truncated": {
            "type": "boolean"
          },
          "cap": {
            "type": "integer",
            "minimum": 1
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/message"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "message": {
      "type": "object",
      "required": [
        "id",
        "t"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "t": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"
        },
        "text": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "reply_to": {
          "type": "integer"
        },
        "fwd": {
          "type": "string"
        },
        "edited": {
          "type": "boolean"
        },
        "media": {
          "type": "string"
        },
        "poll": {
          "type": "object",
          "required": [
            "options"
          ],
          "properties": {
            "question": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preview": {
          "type": "string"
        },
        "views": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  }
}